# Independent 1080p30 camera + DDR3 + HDMI board constraints.
# HDMI/DDR assignments mechanically selected from board-matching demo.
# DVP/LED assignments selected from the user's working capture project.
create_clock -name {sys_clk_27m} [get_ports {sys_clk}] -period {37.037} -waveform {0.000 18.519}
create_clock -name {cam_pclk_clk} [get_ports {cam_pclk}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {ddr_ref_125m} [get_ports {clk_p}] -period {8.000} -waveform {0.000 4.000}
create_generated_clock -name {hdmi_pix_74m} -source [get_ports {sys_clk}] [get_nets {u_pll.clkout0}] -master_clock [get_clocks {sys_clk_27m}] -multiply_by {11} -divide_by {4}
create_generated_clock -name {cfg_clk_10m} -source [get_ports {sys_clk}] [get_nets {u_pll.clkout1}] -master_clock [get_clocks {sys_clk_27m}] -multiply_by {10} -divide_by {27}

# DDR3 PHY clocks are constrained using the board demo's DDR3 IP recipe,
# adapted to the two wrapper levels in this independent project. Do not
# accept the timing tool's otherwise inferred 1 MHz clocks for this IP.
create_generated_clock -name {ddr_rst_clk} -source [get_ports {clk_p}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_125m}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_125m}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_125m}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_125m}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr.u_ddr.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}]
set_multicycle_path 2 -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name {sys_clk_27m_group} -asynchronous -group [get_clocks {sys_clk_27m}]
set_clock_groups -name {ddr_ref_group} -asynchronous -group [get_clocks {ddr_ref_125m}]
set_clock_groups -name {ddr_rst_group} -asynchronous -group [get_clocks {ddr_rst_clk}]
set_clock_groups -name {phy_dq_0_group} -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name {phy_dq_1_group} -asynchronous -group [get_clocks {phy_dq_clk_1}]
# The registered 10 MHz board-reset output is an asynchronous input to the
# DDR3 IP's internal reset synchronizer, as in the board-matched reference.
set_clock_groups -name {cfg_clk_group} -asynchronous -group [get_clocks {cfg_clk_10m}]
# The only pixel/core crossings are the Gray-coded video FIFO pointers and
# synchronizer/status/reset paths. They cannot be timed as synchronous paths.
set_clock_groups -name {hdmi_pix_group} -asynchronous -group [get_clocks {hdmi_pix_74m}]
# OV5640 PCLK is not phase-locked to the board/DDR clocks. Its crossings
# are the Gray-pointer FIFO and status/reset synchronizers, not timed paths.
set_clock_groups -name {camera_pclk_group} -asynchronous -group [get_clocks {cam_pclk_clk}]
